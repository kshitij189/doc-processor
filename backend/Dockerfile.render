FROM python:3.12-slim

WORKDIR /app

# Install system dependencies (Tesseract OCR + an in-container Redis to act as
# the Celery broker, so the deployment does not depend on an external free-tier
# Redis that can be reclaimed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    tesseract-ocr \
    redis-server \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
# No PyTorch: embeddings run on onnxruntime via fastembed, which costs roughly a
# third of the memory and is what lets this fit in a 512MB instance.
RUN pip install --no-cache-dir --default-timeout=1000 -r requirements.txt

# Bake the embedding and re-ranker models into the image. Otherwise the first
# document processed downloads them from HuggingFace inside the Celery task,
# where a slow or stalled download leaves the job hanging with no timeout and
# the UI stuck mid-progress.
ENV FASTEMBED_CACHE_PATH=/app/.cache/fastembed \
    HF_HOME=/app/.cache/huggingface
RUN python -c "\
from fastembed import TextEmbedding; \
from fastembed.rerank.cross_encoder import TextCrossEncoder; \
TextEmbedding(model_name='sentence-transformers/all-MiniLM-L6-v2'); \
TextCrossEncoder(model_name='Xenova/ms-marco-MiniLM-L-6-v2'); \
print('models cached')"

COPY backend/ .

# Create uploads and chromadb directories
RUN mkdir -p /app/uploads /app/chromadb_data

# Make start.sh executable and ensure Unix line endings
RUN chmod +x /app/start.sh && sed -i 's/\r$//' /app/start.sh

EXPOSE 8000

# Run both FastAPI and Celery worker using the unified start script
CMD ["/app/start.sh"]
