FROM python:3.12-slim

WORKDIR /app

# Install system dependencies (Tesseract OCR + an in-container Redis to act as
# the Celery broker, so the deployment does not depend on an external free-tier
# Redis that can be reclaimed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    tesseract-ocr \
    redis-server \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
# Install CPU-only PyTorch first to avoid downloading massive CUDA binaries (~900MB)
RUN pip install --no-cache-dir --default-timeout=1000 torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir --default-timeout=1000 -r requirements.txt

# Bake the embedding and re-ranker models into the image. Otherwise the first
# document processed downloads ~150MB from HuggingFace inside the Celery task,
# where a slow or stalled download leaves the job hanging with no timeout and
# the UI stuck mid-progress.
ENV HF_HOME=/app/.cache/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/app/.cache/sentence_transformers
RUN python -c "\
from sentence_transformers import SentenceTransformer, CrossEncoder; \
SentenceTransformer('all-MiniLM-L6-v2'); \
CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2'); \
print('models cached')"

COPY backend/ .

# Create uploads and chromadb directories
RUN mkdir -p /app/uploads /app/chromadb_data

# Make start.sh executable and ensure Unix line endings
RUN chmod +x /app/start.sh && sed -i 's/\r$//' /app/start.sh

EXPOSE 8000

# Run both FastAPI and Celery worker using the unified start script
CMD ["/app/start.sh"]
